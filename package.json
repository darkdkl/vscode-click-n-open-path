{
  "name": "click-n-open-path",
  "displayName": "Click'n'Open Path",
  "description": "Ctrl/Cmd+Click a file path in your code, comments or configs to open the file.",
  "icon": "images/icon.png",
  "version": "0.5.0",
  "publisher": "dark-dmake",
  "license": "SEE LICENSE IN LICENSE.txt",
  "bugs": {
    "url": "https://github.com/darkdkl/vscode-click-n-open-path/issues"
  },
  "homepage": "https://github.com/darkdkl/vscode-click-n-open-path#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/darkdkl/vscode-click-n-open-path.git"
  },
  "qna": "https://github.com/darkdkl/vscode-click-n-open-path/issues",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "path",
    "file path",
    "open file",
    "link",
    "ctrl+click",
    "cmd+click",
    "go to file",
    "navigation"
  ],
  "galleryBanner": {
    "color": "#1d2633",
    "theme": "dark"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "configuration": {
      "title": "Click'n'Open Path",
      "properties": {
        "clickOpenPath.underline": {
          "type": "boolean",
          "default": false,
          "description": "Always underline the paths that can be opened. When off, a path is underlined only while you hover it with Ctrl (Cmd on macOS) held, like Go to Definition, and F12 / Peek work on it."
        },
        "clickOpenPath.searchRoots": {
          "type": "array",
          "scope": "resource",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Extra directories (absolute, or relative to the workspace folder) to resolve relative paths against."
        },
        "clickOpenPath.unquotedPaths": {
          "type": "boolean",
          "scope": "resource",
          "default": true,
          "description": "Also detect paths outside of quotes (comments, YAML, Markdown, shell, .env). Such paths must contain a '/' or '\\'."
        },
        "clickOpenPath.maxFileSize": {
          "type": "number",
          "scope": "resource",
          "default": 1000000,
          "markdownDescription": "Only with `clickOpenPath.underline`: skip documents larger than this many characters."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "typecheck": "tsc -p ./ --noEmit",
    "test": "npm run compile && node --test test/*.test.js",
    "package": "vsce package --out click-n-open-path-$npm_package_version.vsix"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/vscode": "~1.80.0",
    "@vscode/vsce": "^3.9.2",
    "typescript": "^7.0.2"
  }
}
